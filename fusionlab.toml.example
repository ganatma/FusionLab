# FusionLab compute configuration (optional). Copy to fusionlab.toml at the repo root, beside .env.
# Every value can also be set with a FUSIONLAB_* environment variable (see .env.example); the env
# var wins over this file. Neither place ever holds a key, password, or token — the connection uses
# the user's own SSH config, agent, and keys (design §8). The worker's shared token is env-only by
# design (FUSIONLAB_WORKER_TOKEN in .env, both ends); a credential-shaped key in this file is a
# loud config error, never a silently-carried option.

[compute]
# "local" (default): compute runs in this process — zero config, works offline.
# "ssh": GPU-bound tasks run on your own host over SSH — see the README section
# "User-provided compute (SSH)" and docs/COMPUTE.md.
# provider = "local"

# Which [compute.hosts.*] profile to use when several are defined (FUSIONLAB_COMPUTE_HOST wins).
# With a single profile defined it is used without a selector.
# host = "gpu-lab"

# One table per GPU box; switch with FUSIONLAB_COMPUTE_HOST (env) or the [compute] host key above.
# Each profile carries the same keys as the legacy [compute.ssh] table below.
[compute.hosts.gpu-lab]
host = "gpu-lab"             # any ~/.ssh/config alias resolves as-is
remote_dir = "~/FusionLab"   # where the FusionLab clone lives on that host
autostart = true             # run `uv run fusionlab-worker` over SSH when no worker answers
# port = 8420                # local end of the tunnel on this machine — give each host its own
#                            # port when two FusionLab instances share this laptop
# remote_port = 8420         # port the worker binds on the remote host, loopback-only

# A second box is one more block away — select it with FUSIONLAB_COMPUTE_HOST=gpu-lab-2.
# [compute.hosts.gpu-lab-2]
# host = "gpu-lab-2"
# remote_dir = "~/FusionLab"
# autostart = true
# port = 8421
# remote_port = 8420

[compute.ssh]
# The degenerate single-host table, still supported unchanged; prefer a [compute.hosts.*] profile
# once you might own more than one box. A populated [compute.ssh] table wins when no host is selected.
# host = "ousaisrvr"
# remote_dir = "~/FusionLab"
# autostart = true
# port = 8420
# remote_port = 8420
