# FusionLab runs fully offline: physics and ML need no API keys and no network.
# Optional overrides:
FUSIONLAB_PORT=8000
# Force torch device: mps | cuda | cpu (default: auto)
FUSIONLAB_DEVICE=

# User-provided compute over SSH — see the README section "User-provided compute (SSH)" and
# docs/COMPUTE.md. These override (or replace) the matching [compute] keys in fusionlab.toml at the
# repo root; the env var wins. No key, password, or token belongs here: SSH auth comes from the
# user's own config, agent, and keys.
# FUSIONLAB_COMPUTE_PROVIDER=local
# FUSIONLAB_SSH_HOST=
# FUSIONLAB_SSH_REMOTE_DIR=~/FusionLab
# FUSIONLAB_SSH_AUTOSTART=true
# FUSIONLAB_SSH_PORT=8420
# FUSIONLAB_SSH_REMOTE_PORT=8420

# --- Optional in-app agent: all three are unnecessary for the offline demo -------------------
# Master switch for the agent panel; optional, off unless exactly 1, true, or yes.
FUSIONLAB_AGENT_ENABLED=
# Chat model; optional (default: claude-opus-5-5).
FUSIONLAB_AGENT_MODEL=
# Anthropic API key; optional, only read when the agent is enabled. Secrets live here, never in code.
ANTHROPIC_API_KEY=
